{
  "name": "opencode-v2-trace",
  "version": "0.2.0",
  "description": "OpenCode v2 transport tracing with a live UML sequence viewer for prompts, responses and tool executions",
  "license": "MIT",
  "type": "module",
  "exports": "./index.ts",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "viewer.js",
    "sequence/",
    "example.html",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uwevanheesch-th/opencode-v2-trace.git"
  },
  "homepage": "https://github.com/uwevanheesch-th/opencode-v2-trace#readme",
  "bugs": {
    "url": "https://github.com/uwevanheesch-th/opencode-v2-trace/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "trace",
    "llm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint index.ts",
    "typecheck": "tsc",
    "test": "npm run test:sequence",
    "sequence": "node sequence/server.mjs",
    "test:sequence": "node --test sequence/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@opencode/plugin": "2.0.19",
    "@tsconfig/node22": "22.0.2",
    "@types/node": "22.13.9",
    "eslint": "^9.39.4",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0"
  }
}
